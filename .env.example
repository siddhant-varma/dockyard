# ── Deployment Mode ─────────────────────────────────────────────
# "local"  = filesystem discovery, localhost health checks (default)
# "server" = Dokploy + Hetzner + GitHub integration
DOCKYARD_MODE=local

# ── Auth ───────────────────────────────────────────────────────
# Enable login system (true/false). When false, all pages are public.
DOCKYARD_AUTH_ENABLED=false
# Enable TOTP-based 2FA (requires DOCKYARD_AUTH_ENABLED=true)
DOCKYARD_2FA_ENABLED=false
# Admin credentials for simple auth (when GitHub OAuth is not configured)
DOCKYARD_ADMIN_USER=admin
DOCKYARD_ADMIN_PASSWORD=

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://dockyard:dockyard@localhost:5433/dockyard

# ── Auth (Auth.js v5 / NextAuth) — only when DOCKYARD_AUTH_ENABLED=true
AUTH_SECRET=generate-a-random-secret
AUTH_GITHUB_ID=your-github-oauth-app-client-id
AUTH_GITHUB_SECRET=your-github-oauth-app-client-secret
AUTH_URL=http://localhost:3000

# ── Dokploy — only when DOCKYARD_MODE=server
DOKPLOY_API_URL=https://your-dokploy-instance.com/api
DOKPLOY_API_KEY=your-dokploy-api-key

# ── Hetzner Cloud — only when DOCKYARD_MODE=server
HETZNER_API_TOKEN=your-hetzner-cloud-api-token
HETZNER_SERVER_ID=your-server-id

# ── Encryption (for config values)
CONFIG_ENCRYPTION_KEY=generate-a-32-byte-hex-key

# ── Domain
DOCKYARD_DOMAIN=dockyard.cc

# ── Notifications (optional)
RESEND_API_KEY=
SLACK_WEBHOOK_URL=

# ── Inngest (optional)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
