# ── Deployment Mode ─────────────────────────────────────────────
# "local"  = filesystem discovery, localhost health checks (default)
# "server" = Dokploy + Hetzner + GitHub integration
DOCKYARD_MODE=local

# ── Demo Mode ──────────────────────────────────────────────────
# Skips all API/DB calls, uses static demo data for UI development.
# Set to "true" when running the frontend without a database.
DOCKYARD_DEMO=false

# ── Diagnostic Mode ───────────────────────────────────────────
# Attempts real data fetches but catches errors. Shows inline error
# cards for failed components. Useful for verifying which APIs are working.
DOCKYARD_DIAGNOSTIC=false

# ── Auth ───────────────────────────────────────────────────────
# Enable login system (true/false). When false, all pages are public.
DOCKYARD_AUTH_ENABLED=false
# Enable TOTP-based 2FA (requires DOCKYARD_AUTH_ENABLED=true)
DOCKYARD_2FA_ENABLED=false
# Admin credentials for simple auth (when GitHub OAuth is not configured)
DOCKYARD_ADMIN_USER=admin
DOCKYARD_ADMIN_PASSWORD=

# ── Session Timeouts ──────────────────────────────────────────
# Idle timeout in seconds (default: 1800 = 30 minutes, NIST 800-63B AAL1)
DOCKYARD_SESSION_IDLE_TIMEOUT=1800
# Absolute timeout in seconds (default: 28800 = 8 hours, OWASP recommendation)
DOCKYARD_SESSION_ABSOLUTE_TIMEOUT=28800

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://dockyard:dockyard@localhost:5433/dockyard

# ── Auth (Auth.js v5 / NextAuth) — only when DOCKYARD_AUTH_ENABLED=true
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GITHUB_ID=your-github-oauth-app-client-id
AUTH_GITHUB_SECRET=your-github-oauth-app-client-secret
AUTH_URL=http://localhost:3000

# ── GitHub Discovery — auto-creates a GitHub discovery source on first scan
# Set org OR user (not both) to scan repos from
GITHUB_ORG=
GITHUB_USER=

# ── Dokploy — only when DOCKYARD_MODE=server
DOKPLOY_API_URL=https://your-dokploy-instance.com/api
DOKPLOY_API_KEY=your-dokploy-api-key
# Dokploy application ID for DockYard's own log viewer (optional)
DOKPLOY_APP_ID=

# ── Hetzner Cloud — only when DOCKYARD_MODE=server
HETZNER_API_TOKEN=your-hetzner-cloud-api-token
HETZNER_SERVER_ID=your-server-id

# ── Encryption (for config values)
# Generate with: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=

# ── Domain
DOCKYARD_DOMAIN=dockyard.cc

# ── Notifications (optional)
RESEND_API_KEY=
SLACK_WEBHOOK_URL=

# ── SSE (internal broadcast auth — required in production)
# Generate with: openssl rand -base64 32
SSE_BROADCAST_SECRET=

# ── GitHub Webhooks — signature verification (optional)
GITHUB_WEBHOOK_SECRET=

# ── Uptime Kuma (optional — external health monitoring integration)
# Base URL of the Uptime Kuma instance
KUMA_URL=http://localhost:3002
# API key (preferred, v1.23+) — generate in Kuma → Settings → API Keys
KUMA_API_KEY=
# Username/password fallback (only if API key is not set)
KUMA_USERNAME=
KUMA_PASSWORD=
# Shared secret for validating incoming Kuma webhook notifications
# Generate with: openssl rand -base64 32
KUMA_WEBHOOK_SECRET=

# ── Health Monitoring Token (optional — allows Kuma to access /api/health/deep)
# Append ?token=<value> to deep health URLs in Kuma monitors
# Generate with: openssl rand -base64 32
HEALTH_MONITOR_TOKEN=

# ── AI Provider (optional — for AI summaries, confidence scoring)
DOCKYARD_AI_PROVIDER=anthropic
DOCKYARD_AI_MODEL=
DOCKYARD_AI_MAX_TOKENS=2048
DOCKYARD_AI_TEMPERATURE=0.3

# ── Inngest (optional)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Logging ─────────────────────────────────────────────────────
# Log level: fatal | error | warn | info | debug | trace
# Default: info (production), debug (development), warn (test)
LOG_LEVEL=

# ── Public URL (used in SSE connections and metadata links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
