{
  "deny": [
    "rm -rf",
    "git push --force",
    "git push -f",
    "DROP DATABASE",
    "drop database",
    "DROP TABLE",
    "drop table",
    "TRUNCATE",
    "truncate",
    "reboot",
    "shutdown",
    "poweroff",
    "halt",
    "systemctl stop docker",
    "systemctl restart docker",
    "systemctl disable docker",
    "docker-compose down",
    "docker compose down",
    "docker volume rm",
    "docker volume prune",
    "docker system prune",
    "docker rm -f dockyard",
    "docker stop dockyard",
    "docker rm -f kuma",
    "docker stop kuma",
    "docker rm -f postgres",
    "docker stop postgres",
    "iptables -F",
    "iptables -X",
    "iptables -P INPUT DROP",
    "ufw deny 22",
    "ufw disable",
    "dd if=",
    "mkfs",
    "kill -9",
    "pkill docker",
    "pkill node",
    "userdel",
    "passwd"
  ]
}
